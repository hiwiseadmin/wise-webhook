{
    "name": "wiseadmin/wise-webhook",
    "description": "WiseAdmin Webhook 发送与接收解决方案 — 支持签名、重试、退避、多端点、队列处理",
    "homepage": "https://github.com/hiwiseadmin/wise-webhook",
    "type": "library",
    "license": "Apache-2.0",
    "keywords": [
        "thinkphp",
        "wiseadmin",
        "webhook",
        "webhook-server",
        "webhook-client"
    ],
    "authors": [
        {
            "name": "WiseAdmin Team",
            "email": "wiseadmin@126.com"
        }
    ],
    "require": {
        "php": ">=8.1",
        "topthink/framework": "^8.0",
        "ext-json": "*",
        "ext-curl": "*"
    },
    "suggest": {
        "topthink/think-queue": "用于异步发送和处理 Webhook",
        "topthink/think-migration": "用于数据库迁移"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.0",
        "mockery/mockery": "^1.5"
    },
    "autoload": {
        "psr-4": {
            "wise\\webhook\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "wise\\webhook\\tests\\": "tests/"
        }
    },
    "extra": {
        "think": {
            "services": [
                "wise\\webhook\\WebhookServiceProvider"
            ],
            "config": {
                "wise-webhook": "config/wise-webhook.php"
            },
            "migrate-path": "database/migrations"
        }
    },
    "archive": {
        "exclude": [
            "/tests",
            "/docs",
            "/.github",
            "/phpunit.xml",
            "/phpunit.xml.dist",
            "/.gitattributes",
            "/.gitignore",
            "/*.md",
            "!/README.md",
            "/qa/"
        ]
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
